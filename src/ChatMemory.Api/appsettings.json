{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27018",
    "Database": "chatmemory"
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "llama3.2:3b",
    "TimeoutSeconds": 100
  },
  "ChatMemory": {
    "Strategy": "Summarizing",
    "TargetMessageCount": 10,
    "SummarizationThreshold": 5,
    "MaxInputCharacters": 4000,
    "MaxTitleCharacters": 120,
    "MaxConcurrencyRetries": 1,
    "SystemPrompt": "You are a helpful, concise assistant. Answer in the language the user writes in."
  }
}
