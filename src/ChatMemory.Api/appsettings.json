{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "chatmemory"
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "llama3.2:3b"
  },
  "ChatMemory": {
    "Strategy": "summarizing",
    "TargetMessageCount": 10,
    "SummarizationThreshold": 5,
    "SystemPrompt": "You are a helpful, concise assistant. Answer in the language the user writes in."
  }
}
